# Copy to .env for local runs. Never commit real values.
ORBIT_SECRET_KEY=change-me-to-a-long-random-string
ORBIT_STORE=memory            # memory | postgres | firestore
ORBIT_TICK_TOKEN=change-me    # shared secret Cloud Scheduler sends in X-Tick-Token
ORBIT_BASE_URL=http://localhost:8080
ORBIT_COOKIE_SECURE=0         # 1 in production (HTTPS)
ORBIT_INPROCESS_TICK=1        # 1 = run the reminder loop inside the app (local runs)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
DATABASE_URL=                  # with ORBIT_STORE=postgres
BREVO_API_KEY=                 # optional: send email over HTTPS instead of SMTP
MAIL_FROM=                     # sender address verified in Brevo
